					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Перевіряємо, що запит пройшов успішно (код 200 або 201)",
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const responseData = pm.response.json();",
									"    ",
									"    // Спускаємося в структуру: responseData -> book -> id",
									"    const bookId = responseData.book.id;",
									"    ",
									"    // Зберігаємо id у змінну колекції",
									"    pm.collectionVariables.set(\"book_id\", bookId);",
									"    ",
									"    console.log(\"Успішно збережено book_id:\", bookId);",
									"}",
