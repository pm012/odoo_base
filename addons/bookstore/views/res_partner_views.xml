<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_bookstore" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.bookstore</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">           
            <xpath expr="//field[@name='website']" position="after">
                <field name="favorite_genre_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>