<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bookstore_book_list" model="ir.ui.view">
        <field name="name">bookstore.book.list</field>
        <field name="model">bookstore.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="author_id"/>
                <field name="price"/>
                <field name="isbn"/>
                <field name="quantity"/>
                <field name="total_value"/>

            </list>
        </field>
    </record>

    <record id="view_bookstore_book_form" model="ir.ui.view">
        <field name="name">bookstore.book.form</field>
        <field name="model">bookstore.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Book Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Clean Code"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="author_id"/>
                            <field name="isbn"/>
                            <field name="genre_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="quantity"/>
                            <field name="total_value"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description_page">
                            <field name="description" placeholder="Write book synopsis here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bookstore_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">bookstore.book</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bookstore_book_list')}), 
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_bookstore_book_form')})]"/>
    </record>

    <record id="view_bookstore_author_list" model="ir.ui.view">
        <field name="name">bookstore.author.list</field>
        <field name="model">bookstore.author</field>
        <field name="arch" type="xml">
            <list string="Authors">
                <field name="name"/>
                <field name="birth_date"/>
            </list>
        </field>
    </record>

        <record id="view_bookstore_author_form" model="ir.ui.view">
        <field name="name">bookstore.author.form</field>
        <field name="model">bookstore.author</field>
        <field name="arch" type="xml">
            <form string="Author">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Author Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Steve Jobs"/>
                        </h1>
                    </div>
                    <group>
                        <field name="birth_date"/>
                        <field name="biography"/>
                    </group>
                    <group string="Books Written">
                        <field name="book_ids" nolabel="1">
                            <list string="Books" editable="bottom">
                                <field name="name"/>
                                <field name="price"/>
                                <field name="quantity"/>
                                <field name="total_value"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_bookstore_author" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">bookstore.author</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bookstore_author_list')}), 
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_bookstore_author_form')})]"/>
    </record>

    <menuitem id="menu_bookstore_root" name="Bookstore" sequence="10"/>
    <menuitem id="menu_bookstore_books" name="Books" parent="menu_bookstore_root" action="action_bookstore_book" sequence="10"/>
    <menuitem id="menu_bookstore_authors" name="Authors" parent="menu_bookstore_root" action="action_bookstore_author" sequence="20"/>

</odoo>
