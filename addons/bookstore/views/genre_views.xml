<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bookstore_genre_list" model="ir.ui.view">
        <field name="name">bookstore.genre.list</field>
        <field name="model">bookstore.genre</field>
        <field name="arch" type="xml">
            <list string="Genres">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_bookstore_genre_form" model="ir.ui.view">
        <field name="name">bookstore.genre.form</field>
        <field name="model">bookstore.genre</field>
        <field name="arch" type="xml">
            <form string="Genre">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Genre Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Science Fiction"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Books in this Genre">
                            <field name="book_ids" nolabel="1">
                                <list string="Books">
                                    <field name="name"/>
                                    <field name="author_id"/>
                                    <field name="price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bookstore_genre" model="ir.actions.act_window">
        <field name="name">Genres</field>
        <field name="res_model">bookstore.genre</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bookstore_genre_list')}), 
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_bookstore_genre_form')})]"/>
    </record>

    <menuitem id="menu_bookstore_genres" 
              name="Genres" 
              parent="menu_bookstore_root" 
              action="action_bookstore_genre" 
              sequence="30"/>

</odoo>